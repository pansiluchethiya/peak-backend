# --- Required ---
# Generate strong values, for example: openssl rand -hex 24
ADMIN_PASSWORD=
PROXY_SECRET=
PUBLIC_URL=http://localhost:3000

# --- TMDB (optional: streams work without it, search/recommendations do not) ---
TMDB_API_KEY=

# --- Host ports ---
API_PORT=3000
PLAYER_PORT=3001
ADMIN_PORT=3002
PROXY_PORT=80

# --- Optional ---
VIDAPI_BASE_URL=
# Leave empty for same-origin /api through the player (recommended).
PUBLIC_API_URL=
