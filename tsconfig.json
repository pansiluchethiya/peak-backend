{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "allowJs": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "strict": false,
    "noImplicitAny": false,
    "types": ["node"]
  },
  "ts-node": {
    "transpileOnly": true,
    "experimentalResolver": true,
    "compilerOptions": {
      "module": "CommonJS"
    }
  },
  "include": ["scratch/**/*.ts", "api/src/**/*.ts"],
  "exclude": ["node_modules", "**/node_modules", "**/.next", "**/dist"]
}
